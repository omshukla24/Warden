GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
MODEL_ID=gemini-3.5-flash
GEMMA_MODEL_ID=gemma-2-9b-it
GEMMA_ENABLED=true
GEMMA_API_KEY=your-google-ai-studio-key
FIRESTORE_COLLECTION_REGISTRY=warden_registry
FIRESTORE_COLLECTION_AUDIT=warden_audit

SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----\n<YOUR_ED25519_PRIVATE_KEY_BASE64>\n-----END PRIVATE KEY-----"
SIGNING_KEY_PUB_PEM="-----BEGIN PUBLIC KEY-----\n<YOUR_ED25519_PUBLIC_KEY_BASE64>\n-----END PUBLIC KEY-----"

MODEL_ARMOR_TEMPLATE=warden-armor
MODEL_ARMOR_ENABLED=false
SIGNING_KEY_SECRET=warden-ed25519-private
PUBSUB_TOPIC=warden-sweep
